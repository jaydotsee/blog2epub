#!/usr/bin/env bash
# Run the blog2epub CLI from anywhere, through uv, without activating anything:
#
#   bin/blog2epub list
#   bin/blog2epub run tyk
#   bin/blog2epub -v build kong --issue 20260906
#
# `uv run --frozen` uses the environment the lockfile describes and creates it on first use,
# so a fresh clone needs nothing but uv. Every extra is included, so the covers render and
# SVGs rasterise when Chromium and cairo are present; the build says so when they are not.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/_uv.sh
. "$here/bin/_uv.sh"

# On macOS, uv's managed Python builds are self-contained and don't inherit
# Homebrew's lib path, so cairocffi can't find libcairo even when `brew install
# cairo` succeeded. Point the dynamic linker at Homebrew's lib dir so SVG
# rasterisation works without the caller having to know this quirk exists.
if [[ "$(uname -s)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
  brew_lib="$(brew --prefix)/lib"
  export DYLD_FALLBACK_LIBRARY_PATH="${brew_lib}${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
fi

exec "$UV" run --frozen --all-extras --project "$here" blog2epub "$@"
